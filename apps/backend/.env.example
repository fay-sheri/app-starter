# 必填项：请替换为你自己的随机密钥
SECRET_KEY=change-me-to-a-long-random-string

# 可选配置（不写会用默认值）
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 数据库连接地址
# SQLite 示例：
DATABASE_URL=sqlite:///./app.db
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/your_db_name

#RSA秘钥
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."